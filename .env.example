# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Equity and market data
FINNHUB_API_KEY=your_finnhub_api_key_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
FMP_API_KEY=your_financial_modeling_prep_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here

# Fixed Income & Macro data
FRED_API_KEY=your_st_louis_fed_fred_api_key_here

# Crypto data
COINGECKO_API_KEY=your_coingecko_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# AI advisor (Groq free tier recommended: console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
